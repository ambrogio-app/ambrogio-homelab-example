{$AMBROGIO_DOMAIN} {
	tls internal

	# The backend answers the API and the conversation sessions; /mcp/memory stays inside the home network.
	handle /api/* {
		reverse_proxy ambrogio:3000
	}
	handle {
		reverse_proxy ambrogio-web:8080
	}
}

{$OPENCLOUD_DOMAIN} {
	tls internal
	reverse_proxy opencloud:9200
}

# Home Assistant and Music Assistant run on the host network, so the proxy reaches them on the host.
{$HOME_ASSISTANT_DOMAIN} {
	tls internal
	reverse_proxy host.docker.internal:8123
}

{$MUSIC_ASSISTANT_DOMAIN} {
	tls internal
	reverse_proxy host.docker.internal:8095
}
