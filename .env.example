# Copy to .env next to this file and fill in every value. Never commit .env.
# Every compose file is started from the repository root with --env-file .env.

# Domain of the web chat, served by Caddy with a certificate from its own local authority.
AMBROGIO_DOMAIN=ambrogio.example.com

# Releases of the images; see the compatibility table in the documentation.
AMBROGIO_VERSION=v0.17.0
AMBROGIO_WEB_VERSION=v0.3.1

# Language of the answers and voices (en or it) and the family's time zone.
AMBROGIO_LANGUAGE=en
AMBROGIO_TIME_ZONE=Europe/London

# Domains of Home Assistant and Music Assistant, served by Caddy like the web chat.
HOME_ASSISTANT_DOMAIN=home.example.com
MUSIC_ASSISTANT_DOMAIN=music.example.com

# Password of the PostgreSQL archive: letters and digits only, for example `openssl rand -hex 24`.
AMBROGIO_DATABASE_PASSWORD=

# Credentials named by the agent files in ambrogio/agents/.
MISTRAL_API_KEY=
HOME_ASSISTANT_TOKEN=
# Long-lived access token of Music Assistant, created in its profile settings (see the README).
MUSIC_ASSISTANT_TOKEN=
# Any long random string: the weather MCP server requires it and the weather agent sends it.
OPEN_METEO_MCP_TOKEN=

# Domain of OpenCloud, served by Caddy like the web chat.
OPENCLOUD_DOMAIN=cloud.example.com
# Password of the OpenCloud administrator "admin", read only on the first start.
OPENCLOUD_ADMIN_PASSWORD=
# App password of the OpenCloud user "ambrogio", created with `opencloud auth-app create` (see the README).
OPENCLOUD_MCP_APP_TOKEN=
# Any long random string: opencloud-mcp requires it and the files agent sends it.
OPENCLOUD_MCP_TOKEN=

# Folder of the music files on the homelab server, read by Music Assistant.
MUSIC_LIBRARY_DIR=/srv/music
