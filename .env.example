# Copy to .env next to this file and fill in every value. Never commit .env.
# Every compose file is started from the repository root with --env-file .env.

# Domain of the web chat, served by Caddy with a certificate from its own local authority.
AMBROGIO_DOMAIN=ambrogio.example.com

# Releases of the images; see the compatibility table in the documentation.
AMBROGIO_VERSION=v0.17.0
AMBROGIO_WEB_VERSION=v0.3.1

# Language of the answers and voices (en or it) and the family's time zone.
AMBROGIO_LANGUAGE=en
AMBROGIO_TIME_ZONE=Europe/London

# Password of the PostgreSQL archive: letters and digits only, for example `openssl rand -hex 24`.
AMBROGIO_DATABASE_PASSWORD=

# Credentials named by the agent files in ambrogio/agents/.
MISTRAL_API_KEY=
HOME_ASSISTANT_TOKEN=
# Any long random string: the weather MCP server requires it and the weather agent sends it.
OPEN_METEO_MCP_TOKEN=
